# Lido só pelo Agent (agent/index.js) — pra quem ele pinga como "peer" no
# modelo hub-and-spoke (issue 09): todo Node que não é o Master pinga o
# Master, nunca o contrário. Não usado pelo Master/dashboard em si (ele não
# tem peer — é o hub).
MASTER_URL=http://192.168.15.43:3000

# Postgres dedicado do dashboard (multi-node, issue 01) — roda no Postgres que já existe
# no Master (também usado pelo n8n, database separado). Só resolve a partir do próprio
# Master (pg_hba só libera 127.0.0.1/::1); senha real fica só no .env de verdade, nunca aqui.
DATABASE_URL=postgresql://homelab_dash:<password>@127.0.0.1:5432/homelab_dash

# Token que o Agent (agent/index.js) exige no header X-Node-Token de toda
# requisição (issue 06). Cada Node tem o seu próprio, também guardado na
# coluna auth_token da linha desse Node no Postgres — é o que o agregador
# (issue 09) envia quando busca esse Node. Sem essa variável, o Agent
# recusa TODA requisição com 401 (fail-closed, não fail-open).
AGENT_TOKEN=<token>

# API do n8n que já roda no Master (.scratch/n8n-automations/spec.md). URL local
# porque o n8n só precisa ser alcançável a partir do próprio Master (mesma
# máquina do dashboard); a API key é gerada em n8n Settings > API. Sem essas
# duas, /automations mostra "n8n não configurado" em vez de erro.
N8N_URL=http://127.0.0.1:5678
N8N_API_KEY=<token>
